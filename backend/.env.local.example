# 本檔用於本機覆蓋機密，不要提交真實金鑰
# 複製為 .env.local 後填入

# 給代理者 model_config.api_key_ref 使用
OPENAI_API_KEY_TEAM_A=

# 其他可選 key
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Google Picker OAuth（聊天頁「加入谷歌雲端檔案」）
# GOOGLE_CLIENT_ID=
# GOOGLE_API_KEY=

# 排程腳本安全設定（可在本機覆蓋）
# SCHEDULER_SCRIPT_ALLOWED_ROOTS=src,tests
# SCHEDULER_BASH_ALLOWED_PREFIXES=python ,python3 ,node ,npm ,bash ,sh ,./

# Celery worker 調整（可在本機覆蓋）
# CELERY_WORKER_CONCURRENCY=2
# CELERY_WORKER_POOL=prefork

# 衛教來源規則（可在本機覆蓋）
# HEALTH_EDUCATION_TRUSTED_DOMAINS=udnhealth-hd.com
# HEALTH_EDUCATION_BLOCKED_DOMAINS=
# HEALTH_EDUCATION_TRUSTED_ONLY_MODE=false
# HEALTH_EDUCATION_CHINESE_ONLY_MODE=false
# HEALTH_EDUCATION_TRANSLATE_NON_ZH=true
# HEALTH_EDUCATION_ROTATE_EMPTY_ALERT_THRESHOLD=3
