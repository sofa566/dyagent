# dyagent Environment Configuration

# Project
PROJECT_NAME=dyagent
VERSION=0.1.0
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dyagent

# Redis (Session Storage)
REDIS_URL=redis://localhost:6379

# Qdrant (Vector Database)
QDRANT_URL=http://localhost:6333

# 記憶層（Mem0 OSS 範本）
# provider: off | mock | mem0_oss | mem0_platform
AGENT_MEMORY_PROVIDER=mem0_oss
# routing mode: description_only | hybrid | skill_first | memory_first
AGENT_MEMORY_ROUTING_MODE=hybrid
# 主代理分派策略：description_only | hybrid | skill_first | memory_first
ROUTER_ASSIGNMENT_MODE=hybrid
AGENT_MEMORY_READ_ENABLED=true
AGENT_MEMORY_WRITE_ENABLED=true
AGENT_MEMORY_TOP_K=5
AGENT_MEMORY_APP_ID=dyagent
AGENT_MEMORY_WRITE_POLICY=user_assistant_pair
SHORT_TERM_MEMORY_TTL_SEC=3600
SHORT_TERM_MEMORY_MAX_MESSAGES=10

# Mem0 OSS：向量庫（Qdrant）
MEM0_VECTOR_PROVIDER=qdrant
MEM0_QDRANT_HOST=localhost
MEM0_QDRANT_PORT=6333
MEM0_QDRANT_COLLECTION=dyagent_long_term_memories

# Mem0 OSS：LLM / Embedder（可接 OpenAI 相容端點，例如 LiteLLM）
MEM0_LLM_PROVIDER=openai
MEM0_LLM_API_BASE=
MEM0_LLM_MODEL=
MEM0_LLM_API_KEY=
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDER_API_BASE=
MEM0_EMBEDDER_MODEL=
MEM0_EMBEDDER_API_KEY=

# 僅在使用 mem0_platform 時需要
MEM0_API_KEY=

# Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Model Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Picker OAuth（聊天頁「加入谷歌雲端檔案」）
# 由 Google Cloud Console 取得，前端會透過 /api/chat/google-picker-config 讀取
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=

# LLM 成本估算（可選）
# 格式：{"provider:model":{"input_per_1k":0.005,"output_per_1k":0.015}}
# 說明：若供應商未回傳成本，系統會使用此表估算 llm_turns.cost_usd
LLM_COST_TABLE_JSON={"openai:gpt-4o":{"input_per_1k":0.005,"output_per_1k":0.015},"openai:gpt-4o-mini":{"input_per_1k":0.00015,"output_per_1k":0.0006}}

# Embedding 設定
# deterministic: 內建雜湊向量（開發/回退）
# sentence_transformers: 使用本機下載模型（需安裝 sentence-transformers）
# ollama: 使用本地 Ollama /api/embeddings
# vllm: 使用 OpenAI 相容 embeddings 端點
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_VLLM_BASE_URL=http://localhost:8000/v1

# Router 路由門檻（0~1）
# embedding 相似度 >= 門檻才直接採用，否則進入 LLM 裁決/回退
ROUTER_EMBEDDING_THRESHOLD=0.55

# 技能意圖排除泛詞（逗號分隔）
# 用於避免僅憑高頻泛詞（如「台灣」）就誤觸發技能
SKILL_INTENT_AMBIGUOUS_TOKENS=台灣,臺灣,taiwan,我要,我想,幫我,請幫我,麻煩幫我,查詢,查一下,有哪些,有什麼,什麼,哪個,是否

# 建議範例一：sentence_transformers
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL_NAME=BAAI/bge-m3

# 建議範例二：ollama
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL_NAME=bge-m3
# EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434

# 建議範例三：vLLM（OpenAI 相容 Embeddings API）
# EMBEDDING_PROVIDER=vllm
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# EMBEDDING_VLLM_BASE_URL=http://localhost:8000/v1

# 資料快取目錄（ZIP 解壓縮、暫存檔）
DATA_CACHE_PATH=/tmp/dyagent-cache

# 排程任務（Celery + RedBeat）
# 若未設定，預設會使用 REDIS_URL
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379
REDBEAT_REDIS_URL=redis://localhost:6379
REDBEAT_KEY_PREFIX=redbeat:
CELERY_TIMEZONE=Asia/Taipei
CELERY_QUEUE_NAME=dyagent.scheduler
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_POOL=prefork

# 排程腳本安全白名單
# 允許的工作目錄/腳本目錄，逗號分隔；相對路徑會以 backend/ 專案根目錄解析
SCHEDULER_SCRIPT_ALLOWED_ROOTS=src,tests
# 允許的 bash 指令前綴，逗號分隔
SCHEDULER_BASH_ALLOWED_PREFIXES=python ,python3 ,node ,npm ,bash ,sh ,./

# 衛教來源規則（可擴充）
# trusted: 可直接進候選池；blocked: 直接拒絕；其他來源預設 review_required
HEALTH_EDUCATION_TRUSTED_DOMAINS=udnhealth-hd.com
HEALTH_EDUCATION_BLOCKED_DOMAINS=
# 是否強制只允許白名單來源（true 時，非 trusted 一律略過）
HEALTH_EDUCATION_TRUSTED_ONLY_MODE=false
# 僅允許中文內容來源（true 時，非中文來源直接略過）
HEALTH_EDUCATION_CHINESE_ONLY_MODE=false
# 非中文內容是否自動翻譯為繁體中文後再入庫
HEALTH_EDUCATION_TRANSLATE_NON_ZH=true
# 衛教輪替空轉告警門檻（連續 no_eligible_content 次數）
HEALTH_EDUCATION_ROTATE_EMPTY_ALERT_THRESHOLD=3
