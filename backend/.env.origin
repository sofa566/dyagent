# Default local dev/test LLM routing
# You can change these values anytime.

# dyagent Environment Configuration

# Project
PROJECT_NAME=dyagent
VERSION=0.1.0
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dyagent

# Redis (Session Storage)
REDIS_URL=redis://localhost:6379

# Qdrant (Vector Database)
QDRANT_URL=http://localhost:6333

LITELLM_CLOUD_PROVIDER=openai
LLM_DEFAULT_TIER=cloud

# 記憶層（Mem0 OSS 範本）
AGENT_MEMORY_PROVIDER=mem0_oss
AGENT_MEMORY_ROUTING_MODE=hybrid
# 主代理分派策略：description_only | hybrid | skill_first | memory_first
ROUTER_ASSIGNMENT_MODE=hybrid
AGENT_MEMORY_READ_ENABLED=true
AGENT_MEMORY_WRITE_ENABLED=true
AGENT_MEMORY_TOP_K=5
AGENT_MEMORY_APP_ID=dyagent
AGENT_MEMORY_WRITE_POLICY=user_assistant_pair
SHORT_TERM_MEMORY_TTL_SEC=3600
SHORT_TERM_MEMORY_MAX_MESSAGES=10

# Mem0 OSS：向量庫（Qdrant）
MEM0_VECTOR_PROVIDER=qdrant
MEM0_QDRANT_HOST=localhost
MEM0_QDRANT_PORT=6333
MEM0_QDRANT_COLLECTION=dyagent_long_term_memories

# Mem0 OSS：LLM / Embedder（可接 OpenAI 相容端點，例如 LiteLLM）
MEM0_LLM_PROVIDER=openai
MEM0_LLM_API_BASE=
MEM0_LLM_MODEL=
MEM0_LLM_API_KEY=
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDER_API_BASE=
MEM0_EMBEDDER_MODEL=
MEM0_EMBEDDER_API_KEY=

# 僅在使用 mem0_platform 時需要
MEM0_API_KEY=


# Optional provider model defaults (can be overridden)
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
GEMINI_MODEL=gemini-1.5-pro
GROK_MODEL=grok-2

# No API keys required for local tests (stream will fallback to local slicing)
OPENAI_API_KEY=

# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=

# On‑Prem / Router (optional; only set when needed)
# ONPREM_PROVIDER=ollama           # or: vllm
# ONPREM_MODEL=qwen3:8b-16k        # will be auto-prefixed to 'ollama/<model>' when provider=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# VLLM_BASE_URL=http://localhost:8000/v1
# LITELLM_ONPREM_BASE_URL=
# LITELLM_ONPREM_API_KEY=

# Fail hard when no model route is available
LLM_HARD_FAIL_ON_NO_ROUTE=true
# LLM 成本估算（可選）
# 格式：{"provider:model":{"input_per_1k":0.005,"output_per_1k":0.015}}
# 說明：若供應商未回傳成本，系統會使用此表估算 llm_turns.cost_usd
LLM_COST_TABLE_JSON={"openai:gpt-4o":{"input_per_1k":0.005,"output_per_1k":0.015},"openai:gpt-4o-mini":{"input_per_1k":0.00015,"output_per_1k":0.0006}}

# Embedding 設定
# deterministic: 內建雜湊向量（開發/回退）
# sentence_transformers: 使用本機下載模型（需安裝 sentence-transformers）
# ollama: 使用本地 Ollama /api/embeddings
# vllm: 使用 OpenAI 相容 embeddings 端點
EMBEDDING_PROVIDER=deterministic
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_VLLM_BASE_URL=http://localhost:8000/v1

# Router 路由門檻（0~1）
# embedding 相似度 >= 門檻才直接採用，否則進入 LLM 裁決/回退
ROUTER_EMBEDDING_THRESHOLD=0.55

# 建議範例一：sentence_transformers
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# 建議範例二：ollama
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL_NAME=bge-m3
# EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434

# 建議範例三：vLLM（OpenAI 相容 Embeddings API）
# EMBEDDING_PROVIDER=vllm
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# EMBEDDING_VLLM_BASE_URL=http://localhost:8000/v1

# 資料快取目錄（ZIP 解壓縮、暫存檔）
DATA_CACHE_PATH=/tmp/dyagent-cache

CHAT_DEBUG_TRACE=true
# - CHAT_HISTORY_MODE（off / recent，預設 recent）
# - CHAT_HISTORY_MAX_MESSAGES（預設 8）
# - CHAT_HISTORY_MAX_TOKENS（預設 2500）
# - CHAT_HISTORY_INCLUDE_TOOL_TEXT（預設 false）
CHAT_HISTORY_MAX_MESSAGES=5
CHAT_HISTORY_MAX_TOKENS=1000

# take off color when log
NO_COLOR=1
SKILL_INTENT_AMBIGUOUS_TOKENS=台灣,臺灣,taiwan,我要,我想,幫我,請幫我,麻煩幫我,查詢,查一下,有哪些,有什麼,什麼,哪個,是否
